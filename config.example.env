# pane-pwd configuration.
#
# Copy to the plugin's config directory and edit:
#   cp config.example.env "$(herdr plugin config-dir pane-pwd)/config.env"
#
# Every key can also be overridden per-invocation with an environment
# variable named HERDR_PANE_PWD_<KEY>, e.g. HERDR_PANE_PWD_STYLE=repo.
# Changes are picked up on the next watcher restart:
#   herdr plugin action invoke pane-pwd.start

# How often the watcher re-reads every pane's directory, in milliseconds.
# Herdr emits no "directory changed" event, so this is the worst-case delay
# between a `cd` and the border catching up. Clamped to 100..3600000.
INTERVAL_MS=1000

# Label style for every pane:
#   short     ~/dev/herder-plugins/pwd          (default)
#   basename  pwd
#   repo      herder-plugins/pwd                (relative to the git checkout)
#   full      /Users/you/dev/herder-plugins/pwd
STYLE=short

# Overrides STYLE for the focused pane only. Both default to "short", so every
# pane reads the same. Set STYLE=basename to get short labels everywhere and
# the full path only where your cursor is.
FOCUSED_STYLE=short

# Maximum label length, 4..80. Longer labels are elided from the left with a
# leading "…" so the most specific folders stay readable.
MAX_LEN=40

# Literal text placed in front of every label, e.g. "> " or an icon.
PREFIX=

# How $HOME itself is rendered.
HOME_LABEL=~

# true  a pane you rename by hand is released and never relabelled again
# false pane-pwd always wins
RESPECT_MANUAL=true

# Comma-separated pane ids this plugin must never touch, e.g. w1:p3,w2:p1.
SKIP_PANES=

# A tab holding a single pane reserves no pane border, so there is nothing to
# draw a label on. This falls back to the tab name for that case:
#   single  label the tab only while it holds one pane (recommended)
#   always  label every tab, even split ones
#   off     never touch tab names
# Hand-named tabs are never overwritten, and a tab is renamed back to the
# generated name it had as soon as you split it or stop the plugin.
TAB_LABELS=single

# Consecutive `herdr pane list` failures before the watcher exits rather than
# spinning against a stopped or version-mismatched server.
MAX_FAILURES=10
